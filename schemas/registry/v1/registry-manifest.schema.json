{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tinlance.com/schemas/registry/v1/registry-manifest.schema.json",
  "title": "Tinlance Canonical Ecosystem Registry v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "registry_id",
    "baseline_id",
    "repositories",
    "services",
    "agents",
    "contracts",
    "compatibility_rules"
  ],
  "properties": {
    "schema_version": {
      "const": "registry-manifest/v1"
    },
    "registry_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{2,127}$"
    },
    "baseline_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "repositories": {
      "type": "array",
      "minItems": 5,
      "items": {
        "$ref": "#/$defs/repository"
      }
    },
    "services": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/service"
      }
    },
    "agents": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/agent"
      }
    },
    "contracts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/contract"
      }
    },
    "compatibility_rules": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/compatibility"
      }
    }
  },
  "$defs": {
    "repository": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "repository",
        "reviewed_sha",
        "role"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]{1,63}$"
        },
        "repository": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"
        },
        "reviewed_sha": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "role": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        }
      }
    },
    "service": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "service_id",
        "owner_repository_id",
        "version",
        "api_version",
        "contract_ids",
        "capabilities",
        "authority_mode",
        "enabled"
      ],
      "properties": {
        "service_id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9._-]{2,127}$"
        },
        "owner_repository_id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]{1,63}$"
        },
        "version": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
        },
        "api_version": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+$"
        },
        "contract_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "capabilities": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9._-]{2,127}$"
          }
        },
        "authority_mode": {
          "enum": [
            "sole_consequential_execution",
            "authority_free",
            "conformance_only"
          ]
        },
        "enabled": {
          "type": "boolean"
        }
      }
    },
    "agent": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "agent_id",
        "owner_repository_id",
        "version",
        "capabilities",
        "required_contracts",
        "authority_mode"
      ],
      "properties": {
        "agent_id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9._-]{2,127}$"
        },
        "owner_repository_id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]{1,63}$"
        },
        "version": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
        },
        "capabilities": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9._-]{2,127}$"
          }
        },
        "required_contracts": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {
            "type": "string",
            "minLength": 1
          }
        },
        "authority_mode": {
          "enum": [
            "delegated_only",
            "authority_free"
          ]
        }
      }
    },
    "contract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contract_id",
        "version",
        "schema_path",
        "owner_repository_id",
        "compatibility"
      ],
      "properties": {
        "contract_id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9._-]{2,127}$"
        },
        "version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "schema_path": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "owner_repository_id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]{1,63}$"
        },
        "compatibility": {
          "enum": [
            "exact",
            "backward_compatible_minor",
            "versioned_immutable"
          ]
        }
      }
    },
    "compatibility": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "consumer_id",
        "contract_id",
        "supported_versions",
        "reject_unknown",
        "reject_stale",
        "reject_missing"
      ],
      "properties": {
        "consumer_id": {
          "type": "string",
          "minLength": 1
        },
        "contract_id": {
          "type": "string",
          "minLength": 1
        },
        "supported_versions": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "reject_unknown": {
          "const": true
        },
        "reject_stale": {
          "const": true
        },
        "reject_missing": {
          "const": true
        }
      }
    }
  }
}
