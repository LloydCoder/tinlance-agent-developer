{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://schemas.tinlance.com/tadl/common/v1/common.schema.json",
  "title":"TADL Common","type":"object","additionalProperties":false,
  "$defs":{
    "version":{"type":"string","pattern":"^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "name":{"type":"string","pattern":"^[a-z][a-z0-9.-]{2,127}$"},
    "riskClass":{"type":"string","enum":["R0","R1","R2","R3","R4","R5"]}
  }
}
