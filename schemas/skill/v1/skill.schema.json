{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://schemas.tinlance.com/tadl/skill/v1/skill.schema.json",
  "title":"TADL Skill v1","type":"object","additionalProperties":false,
  "required":["apiVersion","kind","metadata","spec"],
  "properties":{
    "apiVersion":{"const":"tadl.tinlance.com/v1"},
    "kind":{"const":"Skill"},
    "metadata":{"type":"object","additionalProperties":false,"required":["name","version"],"properties":{"name":{"type":"string","pattern":"^[a-z][a-z0-9.-]{2,127}$"},"version":{"type":"string","pattern":"^[0-9]+\\.[0-9]+\\.[0-9]+$"},"description":{"type":"string"}}},
    "spec":{"type":"object","additionalProperties":false,"required":["purpose"],"properties":{"purpose":{"type":"string","minLength":1},"dependencies":{"type":"array","items":{"type":"string"}},"requiredCapabilities":{"type":"array","items":{"type":"string"}},"evaluationSuite":{"type":"string"}}}
  }
}
