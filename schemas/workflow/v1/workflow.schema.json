{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://schemas.tinlance.com/tadl/workflow/v1/workflow.schema.json",
  "title":"TADL Workflow v1","type":"object","additionalProperties":false,
  "required":["apiVersion","kind","metadata","spec"],
  "properties":{
    "apiVersion":{"const":"tadl.tinlance.com/v1"},"kind":{"const":"Workflow"},
    "metadata":{"type":"object","additionalProperties":false,"required":["name","version"],"properties":{"name":{"type":"string"},"version":{"type":"string","pattern":"^[0-9]+\\.[0-9]+\\.[0-9]+$"}}},
    "spec":{"type":"object","additionalProperties":false,"required":["steps"],"properties":{"steps":{"type":"array","minItems":1,"items":{"type":"object","additionalProperties":false,"required":["id","capability"],"properties":{"id":{"type":"string"},"capability":{"type":"string"},"dependsOn":{"type":"array","items":{"type":"string"}}}}}}}
  }
}
